        {
          "function": ["bar"],
          "argument": "src",
          "defaultPath": "/",
          "ignore": ["sdk", "**/__pycache__", "**/.venv"]
        },
        {
          "function": ["do_something"],
          "argument": "src",
          "defaultPath": "/",
          "ignore": ["sdk", "**/__pycache__", "**/.venv"]
        }
      ]
    }
  ]
